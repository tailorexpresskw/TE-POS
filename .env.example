# Local defaults. Copy this file to .env only if you need to change them.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
DATA_DIR=./data

# For your future deployment, use NODE_ENV=production and HOST=0.0.0.0.
# PUBLIC_URL=https://your-own-domain.example
# ADMIN_NAME=Administrator
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=set-a-long-private-password-here
# Keep .env private. Never commit the real administrator password.

# Optional Web Push overrides. Otherwise keys are generated in data/web-push.json.
# VAPID_PUBLIC_KEY=your-public-key
# VAPID_PRIVATE_KEY=your-private-key
# VAPID_SUBJECT=mailto:your-contact@example.com
# DISABLE_WEB_PUSH=1
